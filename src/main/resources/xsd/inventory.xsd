<?xml version="1.0" encoding="UTF-8"?>
<xs:schema
        xmlns:xs="http://www.w3.org/2001/XMLSchema"
        targetNamespace="http://example.com/inventory"
        xmlns:tns="http://example.com/inventory"
        elementFormDefault="qualified">

    <!-- Product definition -->
    <xs:complexType name="Product">
        <xs:sequence>
            <xs:element name="id" type="xs:int"/>
            <xs:element name="name" type="xs:string"/>
            <xs:element name="quantity" type="xs:int"/>
            <xs:element name="price" type="xs:double"/>
            <xs:element name="category" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>


    <!-- Add Product -->
    <xs:element name="AddProductRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="product" type="tns:Product"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="AddProductResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="success" type="xs:boolean"/>
                <xs:element name="message" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>


    <!-- Get Product -->
    <xs:element name="GetProductRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="id" type="xs:int"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="GetProductResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="success" type="xs:boolean"/>
                <xs:element name="message" type="xs:string"/>
                <xs:element name="product"
                            type="tns:Product"
                            minOccurs="0"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>


    <!-- Update Product -->
    <xs:element name="UpdateProductRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="product" type="tns:Product"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="UpdateProductResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="success" type="xs:boolean"/>
                <xs:element name="message" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>


    <!-- Delete Product -->
    <xs:element name="DeleteProductRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="id" type="xs:int"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="DeleteProductResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="success" type="xs:boolean"/>
                <xs:element name="message" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>


    <!-- Check Supplier Availability -->
    <xs:element name="CheckSupplierAvailabilityRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="productId" type="xs:int"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="CheckSupplierAvailabilityResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="productId" type="xs:int"/>
                <xs:element name="supplierName" type="xs:string"/>
                <xs:element name="availableQuantity" type="xs:int"/>
                <xs:element name="supplierPrice" type="xs:double"/>
                <xs:element name="available" type="xs:boolean"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>


    <!-- Supporting types for Combined External Info -->
    <xs:complexType name="SupplierInfo">
        <xs:sequence>
            <xs:element name="supplierName" type="xs:string"/>
            <xs:element name="availableQuantity" type="xs:int"/>
            <xs:element name="supplierPrice" type="xs:double"/>
            <xs:element name="available" type="xs:boolean"/>
            <xs:element name="status" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="CurrencyInfo">
        <xs:sequence>
            <xs:element name="baseCurrency" type="xs:string"/>
            <xs:element name="targetCurrency" type="xs:string"/>
            <xs:element name="exchangeRate" type="xs:double"/>
            <xs:element name="convertedPrice" type="xs:double"/>
            <xs:element name="status" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="WeatherInfo">
        <xs:sequence>
            <xs:element name="location" type="xs:string"/>
            <xs:element name="temperature" type="xs:double"/>
            <xs:element name="windSpeed" type="xs:double"/>
            <xs:element name="weatherCondition" type="xs:string"/>
            <xs:element name="status" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>


    <!-- Get Product External Info -->
    <xs:element name="GetProductExternalInfoRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="id" type="xs:int"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="GetProductExternalInfoResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="success" type="xs:boolean"/>
                <xs:element name="message" type="xs:string"/>
                <xs:element name="product" type="tns:Product" minOccurs="0"/>
                <xs:element name="supplierInfo" type="tns:SupplierInfo" minOccurs="0"/>
                <xs:element name="currencyInfo" type="tns:CurrencyInfo" minOccurs="0"/>
                <xs:element name="weatherInfo" type="tns:WeatherInfo" minOccurs="0"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>


    <!-- Get All Products -->
    <xs:element name="GetAllProductsRequest">
        <xs:complexType/>
    </xs:element>

    <xs:element name="GetAllProductsResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="products" type="tns:Product" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>